# Copy this file to .env and add credentials locally. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
FRED_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Live orders require all three controls: config execution.live_enabled=true,
# account validation approval, and this exact acknowledgement.
MQ3_LIVE_TRADING_CONFIRMATION=

# Exchange live mode has a separate acknowledgement and remains disabled in
# code until the connector is deliberately created with live_enabled=true.
MQ3_BITGET_LIVE_CONFIRMATION=

# One environment variable per isolated MT5 terminal worker. These example
# names are referenced from the no-secret terminal manifest only.
MQ3_MT5_PASSWORD_5K=
MQ3_MT5_PASSWORD_25K=
MQ3_MT5_PASSWORD_50K=
MQ3_MT5_PASSWORD_100K=

# Desktop control is intentionally disabled unless both flags are explicitly set.
MQ3_ENABLE_SCREEN_CAPTURE=false
MQ3_ENABLE_DESKTOP_CONTROL=false

# Required if intentionally binding the dashboard beyond localhost.
MQ3_DASHBOARD_CONTROL_TOKEN=
