rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(communityId) { return get(/databases/$(database)/documents/communities/$(communityId)/memberships/$(request.auth.uid)); }
    function activeMember(communityId) { return signedIn() && membership(communityId).data.state == 'active'; }
    function privileged(communityId) { return activeMember(communityId) && membership(communityId).data.role in ['admin', 'committee', 'founder']; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} { allow read, create, update: if isOwner(userId); allow delete: if false; }
    match /profiles/{userId} { allow read: if signedIn(); allow create, update: if isOwner(userId); allow delete: if false; }
    match /devices/{deviceId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
    match /privateUsers/{userId}/{document=**} { allow read, write: if isOwner(userId); }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if privileged(communityId);
      allow delete: if false;
      match /memberships/{userId} { allow read: if signedIn(); allow write: if false; }
      match /private/{document=**} { allow read: if privileged(communityId); allow write: if false; }
    }
    match /joinRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.state == 'pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || activeMember(resource.data.communityId));
      allow update, delete: if false;
    }
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }
    match /comments/{commentId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update, delete: if false; }
    match /issues/{issueId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update, delete: if false; }
    match /proposals/{proposalId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && request.resource.data.stage in ['draft', 'discussion'];
      allow update, delete: if false;
      match /ballots/{ballotId} { allow read: if signedIn() && (resource.data.voterId == request.auth.uid || activeMember(get(/databases/$(database)/documents/proposals/$(proposalId)).data.communityId)); allow write: if false; }
    }
    match /results/{resultId} { allow read: if signedIn(); allow write: if false; }
    match /treasuries/{treasuryId} { allow read: if signedIn(); allow write: if false; }
    match /ledgerEntries/{entryId} { allow read: if signedIn(); allow write: if false; }
    match /receipts/{receiptId} { allow read: if signedIn(); allow write: if false; }
    match /projects/{projectId} { allow read: if signedIn(); allow write: if false; }
    match /serviceProfiles/{profileId} { allow read: if signedIn(); allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if false; }
    match /requests/{requestId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid; allow update, delete: if false; }
    match /offers/{offerId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.providerId == request.auth.uid; allow update, delete: if false; }
    match /incidents/{incidentId} { allow read: if signedIn(); allow write: if false; }
    match /challenges/{challengeId} { allow read: if signedIn(); allow write: if false; }
    match /auditEvents/{eventId} { allow read: if signedIn(); allow write: if false; }
    match /integrity/{documentId} { allow read: if signedIn(); allow write: if false; }
    match /assistantSessions/{sessionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /notifications/{notificationId} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if false; }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
