{
  "name": "onejourney-gaigs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GAIGS / OneJourney: a local-first civic operating system demo.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:open": "vite --host 127.0.0.1 --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && npx cap sync android",
    "android:add": "npx cap add android",
    "functions:build": "npm --prefix functions run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.4"
  }
}
